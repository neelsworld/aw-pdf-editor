{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AW PDF Editor",
  "version": "0.1.1",
  "identifier": "com.accredworks.aw-pdf-editor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AccredWorks · AW PDF Editor",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
